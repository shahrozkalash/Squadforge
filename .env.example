# SquadForge Autonomous AI Software Development Platform Environment Configuration
PORT=3000
NODE_ENV=development

# Application base URL (used for OAuth redirects, defaults to auto-detected host)
APP_URL=

# Google AI Studio Gemini API Key (Server-side model generation and verifier)
# In AI Studio, provided automatically when MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API is set
GEMINI_API_KEY=

# OpenRouter API Key (Used to route to Claude, GPT-4o, Grok, DeepSeek, Mistral, Qwen, etc.)
OPENROUTER_API_KEY=

# GitHub OAuth Integration (Optional: for connecting GitHub account via OAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
