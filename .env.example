# SquadForge AI Studio Configuration
# Server-side Gemini API is automatically provisioned via MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API
GEMINI_API_KEY=

# Local Server & Storage Defaults (sensible defaults included in codebase)
PORT=3000
NODE_ENV=development
SQLITE_DB_PATH=./squadforge.db
EXECUTION_TIMEOUT_MS=10000
MAX_FILE_SIZE_BYTES=1048576
MAX_PROJECT_SIZE_BYTES=20971520

# Optional: Master encryption secret (defaults to internal fallback if unset)
# ENCRYPTION_SECRET=squadforge-production-master-encryption-key-2026

# Optional: OpenRouter API Key for 3rd-party models (seamlessly falls back to Gemini if unset)
# OPENROUTER_API_KEY=

# Optional: GitHub OAuth App credentials (can also connect via Personal Access Token)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: Email Service credentials for Password Reset OTP delivery
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=security@squadforge.dev