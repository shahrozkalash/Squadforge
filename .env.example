# ==============================================================================
# SQUADFORGE AUTONOMOUS AI DEVELOPMENT PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Security Notice: NEVER commit actual API keys or secret tokens to version control.
# Copy this file to .env and fill in the values appropriate for your environment.

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# PORT: The TCP port on which the Express application server listens.
# Default in development: 3000
PORT=3000

# NODE_ENV: Application environment ('development' | 'production').
# In production, secure cookie flags (SameSite, Secure, HttpOnly) and strict validations are enforced.
NODE_ENV=development

# APP_URL: The canonical public base URL where your SquadForge instance is hosted.
# Used for constructing OAuth redirect URIs (e.g. https://your-domain.run.app).
# If left blank, the server will auto-detect the origin from the Host / X-Forwarded-Host headers.
APP_URL=

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHY & CREDENTIAL VAULT (Recommended / Required for Production)
# ------------------------------------------------------------------------------
# ENCRYPTION_SECRET: 256-bit AES-GCM master key used to encrypt sensitive OAuth tokens and PATs at rest.
# How to obtain: Generate a high-entropy 32+ character random string (e.g., `openssl rand -hex 32`).
# Security: Store securely in your secret manager or cloud environment variables.
ENCRYPTION_SECRET=

# ------------------------------------------------------------------------------
# 3. AI REASONING & VERIFIER ENGINES
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Server-side Google Gemini API key.
# Purpose: Powers the Project Manager, Integration Specialist, code verification, and high-speed local fallback.
# How to obtain: Generate from Google AI Studio (https://aistudio.google.com/app/apikey).
# In Google AI Studio Build environments, this is injected automatically when MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API is enabled.
GEMINI_API_KEY=

# OPENROUTER_API_KEY: OpenRouter API key.
# Purpose: Routes parallel requests to 3rd-party models (Claude 3.5 Sonnet, GPT-4o, Grok-2, DeepSeek-V3, Mistral, Qwen, etc.).
# How to obtain: Sign up at OpenRouter (https://openrouter.ai/keys) and generate an API key.
# Note: If not set, SquadForge automatically runs in intelligent fallback mode using Gemini 3.8 Flash.
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 4. GITHUB REPOSITORY INTEGRATION (Optional)
# ------------------------------------------------------------------------------
# GITHUB_CLIENT_ID: OAuth App Client ID created on GitHub.
# GITHUB_CLIENT_SECRET: OAuth App Client Secret created on GitHub.
# Purpose: Enables users to connect their GitHub accounts via 1-click OAuth popup to automatically
# push generated code to a feature branch and open a Pull Request.
# How to obtain: Create an OAuth App in GitHub Developer Settings (https://github.com/settings/developers)
# with Authorization callback URL: https://<YOUR_APP_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. SECURE EMAIL DELIVERY SERVICE (Optional for Password Reset Emails)
# ------------------------------------------------------------------------------
# Purpose: Sends password reset emails when users use the "Forgot Password" flow.
# If not configured, SquadForge safely handles password resets via one-time cryptographically
# generated reset tokens without exposing email account existence.
# Options: SMTP configuration or Resend API key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SquadForge Security <noreply@squadforge.dev>
RESEND_API_KEY=
