# SquadForge environment configuration
# Copy this file to .env and fill in your own values:  cp .env.example .env
# Never commit your real .env file.

# --- Core ---
# Server port (default: 3000)
PORT=3000
# Environment: development or production
NODE_ENV=development
# Public URL of this app, used for OAuth redirects and trusted-origin checks
# (e.g. http://localhost:3000 locally, https://squadforge.example.com in production)
APP_URL=

# --- AI model providers (at least one is required for the swarm to do real work) ---
# Google Gemini — primary provider. In Google AI Studio this is automatically
# provisioned via MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API.
GEMINI_API_KEY=
# OpenRouter — optional fallback provider
OPENROUTER_API_KEY=

# --- Security ---
# Encryption secret for stored credentials. Set a strong 32+ character random
# string in production — if unset, the server falls back to a built-in default
# that is NOT safe for production.
ENCRYPTION_SECRET=

# --- Database ---
# SQLite database location (default: ./squadforge.db in the working directory)
SQLITE_DB_PATH=

# --- GitHub integration (optional) ---
# GitHub OAuth app credentials, used for "Connect GitHub" and auto-push
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email for password-reset OTP (optional — configure ONE of these) ---
# Option A: Resend
RESEND_API_KEY=
# Option B: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SquadForge Security <security@squadforge.dev>
