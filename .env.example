# ========================================================
# SquadForge Application Environment Variables
# ========================================================

# Master Secret for AES-256-GCM token encryption & HMAC keying
ENCRYPTION_SECRET=

# AI Model Providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# GitHub Integration & Auto-Push OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ========================================================
# Password Reset Email Delivery Service Configuration
# Configure Option A (Resend API) OR Option B (Standard SMTP)
# ========================================================

# Option A: Resend Provider
RESEND_API_KEY=

# Option B: SMTP Provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SquadForge Security" <security@squadforge.dev>