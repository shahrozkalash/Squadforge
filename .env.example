# SquadForge Environment Configuration Template
# Server runtime defaults (non-secret defaults allow instant preview without blocking prompts)
PORT=3000
NODE_ENV=development
SQLITE_DB_PATH=./squadforge.db
ENCRYPTION_SECRET=squadforge-dev-master-encryption-key-2026-secure

# Server-Side AI Orchestration:
# Automatically injected by AI Studio when running in this environment.
# In standalone production, set your Gemini API key:
# GEMINI_API_KEY=

# Optional: Alternative Multi-Model AI Gateway (OpenRouter)
# OPENROUTER_API_KEY=

# Optional: GitHub OAuth Integration
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: Email Service for Password Reset 6-Digit OTP (Resend or SMTP)
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=