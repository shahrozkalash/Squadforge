# ==============================================================================
# SquadForge Environment Configuration
# ==============================================================================
# Copy this file to .env and configure values for your deployment environment.
# Never commit .env with real secrets to source control.
# ==============================================================================

# --- Application Core ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Security & Encryption ---
# 32+ character random secret used for AES-256-GCM encryption of sensitive database fields (e.g. GitHub OAuth tokens).
# Must be set in production. Never store this key inside the database.
ENCRYPTION_SECRET=

# --- Database Storage ---
# Path to SQLite database file. Defaults to squadforge.db in root workspace.
# For production PostgreSQL deployments, provide DATABASE_URL.
SQLITE_DB_PATH=squadforge.db
# DATABASE_URL=postgresql://user:password@localhost:5432/squadforge

# --- AI Model Providers ---
# Google Gemini API Key (Server-Side only; powers Gemini 3.8 Flash worker loop & architect).
GEMINI_API_KEY=

# OpenRouter API Key (Optional; enables multi-model routing for Claude, GPT-4o, DeepSeek, Mistral, Grok).
# If omitted, third-party requests automatically route through Gemini fallback when enabled.
OPENROUTER_API_KEY=

# --- GitHub Integration (Optional) ---
# GitHub OAuth application credentials for repository export and feature branch auto-push.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email Delivery Configuration (Optional) ---
# Required only for sending 6-digit password reset verification codes.
# Provider 1: Resend API Key
RESEND_API_KEY=

# Provider 2: Standard SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@squadforge.dev

# --- Execution Sandbox Limits ---
EXECUTION_TIMEOUT_MS=6000
MAX_FILE_SIZE_BYTES=524288
MAX_PROJECT_SIZE_BYTES=10485760