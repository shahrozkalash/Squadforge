# SquadForge Platform Environment Configuration Template
# Copy this file to .env and configure secrets and credentials.

# Required in Production: Secret key used to encrypt sensitive stored tokens (must be >= 32 chars in production)
ENCRYPTION_SECRET=

# Required for AI Model Operations: Google Gemini API key
GEMINI_API_KEY=

# Optional: OpenRouter API key for external 3P model execution
OPENROUTER_API_KEY=

# Application Host URL (e.g., https://squadforge.example.com) - required in production for strict OAuth redirection
APP_URL=

# Port to bind the server to (default: 3000)
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Storage: Persistent SQLite Database Path (default: ./squadforge.db, or :memory: in dev/test)
SQLITE_DB_PATH=

# GitHub OAuth Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Delivery Configuration (Choose either Resend or SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=