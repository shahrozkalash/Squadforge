PORT=3000
NODE_ENV=development
ENCRYPTION_SECRET=squadforge-master-local-secret-key-32chars
SQLITE_DB_PATH=squadforge.db
EXECUTION_TIMEOUT_MS=15000
MAX_FILE_SIZE_BYTES=512000
MAX_PROJECT_SIZE_BYTES=10485760

